@page "/auth/forgot-password"
@layout MainLayout
@rendermode InteractiveServer
@inject IAuthManager AuthManager
@inject NavigationManager Nav

<PageTitle>Forgot Password — DigiTransfer</PageTitle>

<div class="auth-centered-page">
    <div class="auth-center-card">

        <div class="auth-card-logo">
            <svg viewBox="0 0 50 50" width="44" height="44">
                <defs>
                    <linearGradient id="fpGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" style="stop-color:#4FC3F7" />
                        <stop offset="100%" style="stop-color:#00E5A0" />
                    </linearGradient>
                </defs>
                <circle cx="25" cy="25" r="23" fill="none" stroke="url(#fpGrad)" stroke-width="2.5" />
                <path d="M12 25 H32 M24 17 L34 25 L24 33"
                      stroke="url(#fpGrad)" stroke-width="2.5" fill="none"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="nav-logo-text">
                <span class="logo-digi">Digi</span><span class="logo-transfer">Transfer</span>
            </span>
        </div>

        <div class="auth-icon-circle">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="#1976D2" stroke-width="1.8">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
        </div>

        <h2 class="auth-center-title">Forgot Password?</h2>
        <p class="auth-center-sub">
            Enter your registered email and we'll send you a reset OTP.
        </p>

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success">@_successMessage</div>
            <p class="auth-center-sub" style="margin-top:0.5rem;">
                Check your email for the OTP then
                <a href="/auth/reset-password" class="link-blue">reset your password</a>.
            </p>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-error">@_errorMessage</div>
            }

            <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="ForgotPasswordForm">
                <DataAnnotationsValidator />

                <div class="reg-form-group">
                    <label class="reg-label" style="color:#607080;">Email Address</label>
                    <div class="reg-input-wrap">
                        <svg class="input-icon" viewBox="0 0 24 24" width="18" height="18"
                             fill="none" stroke="#9ab" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                            <polyline points="22,6 12,13 2,6" />
                        </svg>
                        <InputText class="reg-input" @bind-Value="_model.Email"
                                   placeholder="Enter your email address" type="email" />
                    </div>
                    <ValidationMessage For="@(() => _model.Email)" class="validation-message" />
                </div>

                <button type="submit" class="reg-btn-submit" disabled="@_loading">
                    @if (_loading) { <span class="spinner"></span> }
                    Send Reset OTP
                </button>
            </EditForm>
        }

        <div class="reg-divider"><span>OR</span></div>
        <p class="reg-footer">
            Remembered it? <a href="/auth/login">Back to Login</a>
        </p>
    </div>
</div>

@code {
    private readonly ForgotPasswordModel _model = new();
    private string _errorMessage   = string.Empty;
    private string _successMessage = string.Empty;
    private bool   _loading;

    private async Task HandleSubmit()
    {
        _loading        = true;
        _errorMessage   = string.Empty;
        _successMessage = string.Empty;

        var (success, message) = await AuthManager.ForgotPasswordAsync(_model);

        if (success) _successMessage = message;
        else         _errorMessage   = message;

        _loading = false;
    }
}
