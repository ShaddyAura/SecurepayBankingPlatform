@page "/auth/reset-password"
@layout MainLayout
@rendermode InteractiveServer
@inject IAuthManager AuthManager
@inject NavigationManager Nav

<PageTitle>Reset Password — DigiTransfer</PageTitle>

<div class="auth-centered-page">
    <div class="auth-center-card">

        <div class="auth-card-logo">
            <svg viewBox="0 0 50 50" width="44" height="44">
                <defs>
                    <linearGradient id="rpGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" style="stop-color:#4FC3F7" />
                        <stop offset="100%" style="stop-color:#00E5A0" />
                    </linearGradient>
                </defs>
                <circle cx="25" cy="25" r="23" fill="none" stroke="url(#rpGrad)" stroke-width="2.5" />
                <path d="M12 25 H32 M24 17 L34 25 L24 33"
                      stroke="url(#rpGrad)" stroke-width="2.5" fill="none"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="nav-logo-text">
                <span class="logo-digi">Digi</span><span class="logo-transfer">Transfer</span>
            </span>
        </div>

        <div class="auth-icon-circle">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="#1976D2" stroke-width="1.8">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                <polyline points="9 12 11 14 15 10" />
            </svg>
        </div>

        <h2 class="auth-center-title">Reset Password</h2>
        <p class="auth-center-sub">Enter the OTP from your email and set a new password.</p>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-error">@_errorMessage</div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="ResetPasswordForm">
            <DataAnnotationsValidator />

            <!-- OTP -->
            <div class="reg-form-group">
                <label class="reg-label" style="color:#607080;">OTP Code</label>
                <div class="reg-input-wrap">
                    <svg class="input-icon" viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="#9ab" stroke-width="2">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="12" />
                        <line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                    <InputText class="reg-input" @bind-Value="_model.Otp"
                               placeholder="Enter 6-digit OTP"
                               maxlength="6"
                               style="letter-spacing:4px; font-size:1.1rem;" />
                </div>
                <ValidationMessage For="@(() => _model.Otp)" class="validation-message" />
            </div>

            <!-- New Password -->
            <div class="reg-form-group">
                <label class="reg-label" style="color:#607080;">New Password</label>
                <div class="reg-input-wrap">
                    <svg class="input-icon" viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="#9ab" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    <InputText class="reg-input" @bind-Value="_model.NewPassword"
                               placeholder="Create a new password"
                               type="@(_showNew ? "text" : "password")" />
                    <button type="button" class="input-eye" @onclick="() => _showNew = !_showNew">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#9ab" stroke-width="2">
                            @if (_showNew)
                            {
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                            }
                            else
                            {
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            }
                        </svg>
                    </button>
                </div>
                <ValidationMessage For="@(() => _model.NewPassword)" class="validation-message" />
            </div>

            <!-- Confirm Password -->
            <div class="reg-form-group">
                <label class="reg-label" style="color:#607080;">Confirm Password</label>
                <div class="reg-input-wrap">
                    <svg class="input-icon" viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="#9ab" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    <InputText class="reg-input" @bind-Value="_model.ConfirmPassword"
                               placeholder="Confirm new password" type="password" />
                </div>
                <ValidationMessage For="@(() => _model.ConfirmPassword)" class="validation-message" />
            </div>

            <button type="submit" class="reg-btn-submit" disabled="@_loading">
                @if (_loading) { <span class="spinner"></span> }
                Reset Password
            </button>
        </EditForm>

        <p class="reg-footer" style="margin-top:1rem;">
            <a href="/auth/login">Back to Login</a>
        </p>
    </div>
</div>

@code {
    private readonly ResetPasswordModel _model = new();
    private string _errorMessage = string.Empty;
    private bool   _loading;
    private bool   _showNew;

    protected override void OnInitialized()
    {
        // CustomerId can be passed via query string: /auth/reset-password?cid=...
        var uri   = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (Guid.TryParse(query["cid"], out var id))
            _model.CustomerId = id;
    }

    private async Task HandleSubmit()
    {
        _loading      = true;
        _errorMessage = string.Empty;

        var (success, message) = await AuthManager.ResetPasswordAsync(_model);

        if (success)
        {
            await Task.Delay(800);
            Nav.NavigateTo("/auth/login?reset=true");
        }
        else
        {
            _errorMessage = message;
        }

        _loading = false;
    }
}
