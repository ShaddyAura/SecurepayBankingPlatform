@page "/auth/verify-2fa"
@layout MainLayout
@rendermode InteractiveServer
@inject IAuthManager AuthManager
@inject NavigationManager Nav

<PageTitle>Two-Factor Authentication — DigiTransfer</PageTitle>

<div class="auth-centered-page">
    <div class="auth-center-card">

        <div class="auth-card-logo">
            <svg viewBox="0 0 50 50" width="44" height="44">
                <defs>
                    <linearGradient id="2faGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" style="stop-color:#4FC3F7" />
                        <stop offset="100%" style="stop-color:#00E5A0" />
                    </linearGradient>
                </defs>
                <circle cx="25" cy="25" r="23" fill="none" stroke="url(#2faGrad)" stroke-width="2.5" />
                <path d="M12 25 H32 M24 17 L34 25 L24 33"
                      stroke="url(#2faGrad)" stroke-width="2.5" fill="none"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="nav-logo-text">
                <span class="logo-digi">Digi</span><span class="logo-transfer">Transfer</span>
            </span>
        </div>

        <div class="auth-icon-circle" style="background:#fff8e8;">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="#F59E0B" stroke-width="1.8">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                <polyline points="9 12 11 14 15 10" />
            </svg>
        </div>

        <h2 class="auth-center-title">Two-Factor Authentication</h2>
        <p class="auth-center-sub">
            Enter the 6-digit code sent to your registered device.
        </p>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-error">@_errorMessage</div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleVerify" FormName="Verify2FAForm">
            <DataAnnotationsValidator />

            <div class="otp-input-group">
                <div class="reg-input-wrap">
                    <svg class="input-icon" viewBox="0 0 24 24" width="18" height="18"
                         fill="none" stroke="#9ab" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    <InputText class="reg-input otp-input" @bind-Value="_model.Otp"
                               placeholder="0 0 0 0 0 0" maxlength="6" />
                </div>
                <ValidationMessage For="@(() => _model.Otp)" class="validation-message" />
            </div>

            <button type="submit" class="reg-btn-submit" disabled="@_loading">
                @if (_loading) { <span class="spinner"></span> }
                Verify &amp; Continue
            </button>
        </EditForm>

        <button class="btn-resend" @onclick="ResendOtp" disabled="@(_resendCooldown > 0)">
            @(_resendCooldown > 0 ? $"Resend code in {_resendCooldown}s" : "Resend Code")
        </button>

        <p class="reg-footer" style="margin-top:1rem;">
            <a href="/auth/login">Cancel &amp; Back to Login</a>
        </p>
    </div>
</div>

@code {
    private readonly VerifyOtpModel _model = new();
    private string _errorMessage = string.Empty;
    private bool   _loading;
    private int    _resendCooldown;

    protected override void OnInitialized()
    {
        var uri   = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (Guid.TryParse(query["cid"], out var id))
            _model.CustomerId = id;
        _model.Purpose = "TwoFactor";
    }

    private async Task HandleVerify()
    {
        _loading      = true;
        _errorMessage = string.Empty;

        var (success, message) = await AuthManager.Verify2FAOtpAsync(_model);

        if (success)
            Nav.NavigateTo("/dashboard");
        else
            _errorMessage = message;

        _loading = false;
    }

    private async Task ResendOtp()
    {
        _resendCooldown = 60;
        while (_resendCooldown > 0)
        {
            await Task.Delay(1000);
            _resendCooldown--;
            StateHasChanged();
        }
    }
}
