@page "/auth/verify-email"
@layout MainLayout
@rendermode InteractiveServer
@inject IAuthManager AuthManager
@inject NavigationManager Nav

<PageTitle>Verify Email — DigiTransfer</PageTitle>

<div class="auth-centered-page">
    <div class="auth-center-card">

        <div class="auth-card-logo">
            <svg viewBox="0 0 50 50" width="44" height="44">
                <defs>
                    <linearGradient id="veGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" style="stop-color:#4FC3F7" />
                        <stop offset="100%" style="stop-color:#00E5A0" />
                    </linearGradient>
                </defs>
                <circle cx="25" cy="25" r="23" fill="none" stroke="url(#veGrad)" stroke-width="2.5" />
                <path d="M12 25 H32 M24 17 L34 25 L24 33"
                      stroke="url(#veGrad)" stroke-width="2.5" fill="none"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="nav-logo-text">
                <span class="logo-digi">Digi</span><span class="logo-transfer">Transfer</span>
            </span>
        </div>

        <div class="auth-icon-circle" style="background:#e8fff6;">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="#00C07F" stroke-width="1.8">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                <polyline points="22,6 12,13 2,6" />
            </svg>
        </div>

        <h2 class="auth-center-title">Verify Your Email</h2>
        <p class="auth-center-sub">
            Enter the 6-digit OTP sent to your email address.
        </p>

        @if (_verified)
        {
            <div class="alert alert-success">
                ✓ Email verified successfully! Redirecting to login...
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-error">@_errorMessage</div>
            }

            <EditForm Model="_model" OnValidSubmit="HandleVerify" FormName="VerifyEmailForm">
                <DataAnnotationsValidator />

                <div class="otp-input-group">
                    <div class="reg-input-wrap">
                        <svg class="input-icon" viewBox="0 0 24 24" width="18" height="18"
                             fill="none" stroke="#9ab" stroke-width="2">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        <InputText class="reg-input otp-input" @bind-Value="_model.Otp"
                                   placeholder="0 0 0 0 0 0" maxlength="6" />
                    </div>
                    <ValidationMessage For="@(() => _model.Otp)" class="validation-message" />
                </div>

                <button type="submit" class="reg-btn-submit" disabled="@_loading">
                    @if (_loading) { <span class="spinner"></span> }
                    Verify Email
                </button>
            </EditForm>

            <button class="btn-resend" @onclick="ResendOtp" disabled="@(_resendCooldown > 0)">
                @(_resendCooldown > 0 ? $"Resend OTP in {_resendCooldown}s" : "Resend OTP")
            </button>
        }

        <p class="reg-footer" style="margin-top:1rem;">
            <a href="/auth/login">Back to Login</a>
        </p>
    </div>
</div>

@code {
    private readonly VerifyOtpModel _model = new();
    private string _errorMessage = string.Empty;
    private bool   _loading;
    private bool   _verified;
    private int    _resendCooldown;

    protected override void OnInitialized()
    {
        var uri   = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (Guid.TryParse(query["cid"], out var id))
            _model.CustomerId = id;
        _model.Purpose = "EmailVerification";
    }

    private async Task HandleVerify()
    {
        _loading      = true;
        _errorMessage = string.Empty;

        var (success, message) = await AuthManager.VerifyEmailOtpAsync(_model);

        if (success)
        {
            _verified = true;
            await Task.Delay(1500);
            Nav.NavigateTo("/auth/login");
        }
        else
        {
            _errorMessage = message;
        }
        _loading = false;
    }

    private async Task ResendOtp()
    {
        _resendCooldown = 60;
        // TODO: call SendEmailOtp via manager
        while (_resendCooldown > 0)
        {
            await Task.Delay(1000);
            _resendCooldown--;
            StateHasChanged();
        }
    }
}
