@page "/dashboard/notifications"
@layout DashboardLayout
@rendermode InteractiveServer
@inject ISignalRManager   SignalRManager
@inject SessionManager    Session
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Notifications — DigiTransfer</PageTitle>

<div class="dash-page">
    <div class="dash-welcome-row">
        <div>
            <h1 class="dash-welcome-title">Notifications</h1>
            <p class="dash-welcome-sub">Real-time updates from your account activity.</p>
        </div>
        @if (_notifications.Any())
        {
            <button class="btn-apply" @onclick="ClearAll">Clear All</button>
        }
    </div>

    <div class="section-card">
        @if (!_notifications.Any())
        {
            <div style="text-align:center;padding:3rem 0;">
                <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="var(--text-muted)" stroke-width="1.5" style="margin-bottom:1rem;"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                <p style="color:var(--text-muted);font-size:0.9rem;">No notifications yet.</p>
                <p style="color:var(--text-muted);font-size:0.78rem;margin-top:0.3rem;">Notifications appear here when your balance updates or transfers complete.</p>
            </div>
        }
        else
        {
            @foreach (var n in _notifications)
            {
                <div class="notif-item" style="padding:0.9rem 0;">
                    <div class="notif-dot @(n.Type=="balance"?"green-bg":"blue-bg")">
                        @if (n.Type == "balance")
                        {
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#00C07F" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#4FC3F7" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                        }
                    </div>
                    <div style="flex:1;">
                        <p class="notif-title">@n.Title</p>
                        <p class="notif-sub">@n.Message</p>
                        <p class="notif-time">@n.ReceivedAt.ToString("HH:mm:ss")</p>
                    </div>
                    <span class="badge-status @(n.Type=="balance"?"badge-completed":"badge-completed")">Live</span>
                </div>
            }
        }
    </div>
</div>

@code {
    private readonly List<NotificationItem> _notifications = new();

    protected override void OnInitialized()
    {
        if (!Session.IsLoggedIn) return;
        SignalRManager.BalanceUpdated        += OnBalance;
        SignalRManager.TransferStatusChanged += OnTransfer;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Session.IsLoggedIn) Nav.NavigateTo("/auth/login");
    }

    private void OnBalance(decimal balance)
    {
        _notifications.Insert(0, new NotificationItem
        {
            Type      = "balance",
            Title     = "Balance Updated",
            Message   = $"Your balance is now NPR {balance:N2}",
            ReceivedAt = DateTime.Now
        });
        InvokeAsync(StateHasChanged);
    }

    private void OnTransfer(TransferStatusEvent evt)
    {
        _notifications.Insert(0, new NotificationItem
        {
            Type      = "transfer",
            Title     = $"Transfer {evt.Status}",
            Message   = $"NPR {evt.Amount:N2} — Transaction {evt.TransactionId.ToString()[..8]}",
            ReceivedAt = DateTime.Now
        });
        InvokeAsync(StateHasChanged);
    }

    private void ClearAll() => _notifications.Clear();

    public ValueTask DisposeAsync()
    {
        SignalRManager.BalanceUpdated        -= OnBalance;
        SignalRManager.TransferStatusChanged -= OnTransfer;
        return ValueTask.CompletedTask;
    }

    private class NotificationItem
    {
        public string   Type       { get; set; } = string.Empty;
        public string   Title      { get; set; } = string.Empty;
        public string   Message    { get; set; } = string.Empty;
        public DateTime ReceivedAt { get; set; }
    }
}
