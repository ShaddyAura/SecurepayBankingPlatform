@page "/dashboard/transactions"
@page "/dashboard/transactions/{TransactionId:guid}"
@layout DashboardLayout
@rendermode InteractiveServer
@inject IDashboardManager DashboardManager
@inject SessionManager    Session
@inject NavigationManager Nav

<PageTitle>Transaction History — DigiTransfer</PageTitle>

<div class="dash-page">
    <div class="dash-welcome-row">
        <div>
            <h1 class="dash-welcome-title">Transaction History</h1>
            <p class="dash-welcome-sub">Full paginated ledger of your account activity.</p>
        </div>
    </div>

    <div class="section-card">
        <!-- Filters -->
        <div class="th-header">
            <h3 class="section-title" style="margin:0;">All Transactions</h3>
            <div class="th-filters">
                <select class="th-select" @bind="_filterStatus" @bind:after="ApplyFilter">
                    <option value="">All Statuses</option>
                    <option value="Completed">Completed</option>
                    <option value="Pending">Pending</option>
                    <option value="Failed">Failed</option>
                </select>
                <select class="th-select" @bind="_filterDirection" @bind:after="ApplyFilter">
                    <option value="">All Directions</option>
                    <option value="Debit">Debit</option>
                    <option value="Credit">Credit</option>
                </select>
                <button class="btn-apply" @onclick="ApplyFilter">Apply</button>
            </div>
        </div>

        <!-- Table -->
        <table class="tx-table">
            <thead>
                <tr>
                    <th>Date &amp; Time</th>
                    <th>Type</th>
                    <th>Direction</th>
                    <th>Account</th>
                    <th>Amount (NPR)</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (_loading)
                {
                    @for (int i = 0; i < 8; i++)
                    {
                        <tr><td colspan="7"><div class="skeleton-line"></div></td></tr>
                    }
                }
                else if (_filtered is null || !_filtered.Any())
                {
                    <tr><td colspan="7" class="tx-empty">No transactions found.</td></tr>
                }
                else
                {
                    @foreach (var tx in _filtered)
                    {
                        <tr class="@(tx.TransactionId == TransactionId ? "tx-row-highlight" : "")">
                            <td>
                                <div class="tx-date-avatar @GetAvatarClass(tx.Status)">@tx.Status[0]</div>
                                @tx.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                            </td>
                            <td>Transfer</td>
                            <td><span class="tx-direction @(tx.Direction=="Credit"?"dir-credit":"dir-debit")">@tx.Direction</span></td>
                            <td class="tx-mono">@tx.ToAccountId.ToString()[..12]</td>
                            <td class="@(tx.Direction=="Credit"?"amount-credit":"")">
                                @(tx.Direction=="Credit"?"+":"-")@tx.Amount.ToString("N0")
                            </td>
                            <td><span class="badge-status @GetStatusClass(tx.Status)">@tx.Status</span></td>
                            <td><a href="/dashboard/transactions/@tx.TransactionId" class="tx-view-btn">View</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <!-- Pagination -->
        @if (_history is not null && _history.TotalPages > 1)
        {
            <div class="pagination">
                <button class="pg-btn" @onclick="PrevPage" disabled="@(_page==1)">‹</button>
                @for (int i = 1; i <= _history.TotalPages; i++)
                {
                    var pg = i;
                    <button class="pg-btn @(_page==pg?"pg-active":"")" @onclick="()=>GoToPage(pg)">@pg</button>
                }
                <button class="pg-btn" @onclick="NextPage" disabled="@(_page>=_history.TotalPages)">›</button>
            </div>
        }
        <p class="tx-showing">
            Showing @((_page-1)*_pageSize+1)–@Math.Min(_page*_pageSize,_history?.TotalCount??0)
            of @(_history?.TotalCount??0) transactions
        </p>
    </div>

    <!-- Transaction Detail Panel -->
    @if (TransactionId.HasValue && _selected is not null)
    {
        <div class="section-card" style="margin-top:1.25rem;">
            <h3 class="section-title">Transaction Detail</h3>
            <div class="tx-detail-grid">
                <div class="tx-detail-row"><span class="tx-detail-label">Transaction ID</span><span class="tx-mono">@_selected.TransactionId</span></div>
                <div class="tx-detail-row"><span class="tx-detail-label">Direction</span><span class="tx-direction @(_selected.Direction=="Credit"?"dir-credit":"dir-debit")">@_selected.Direction</span></div>
                <div class="tx-detail-row"><span class="tx-detail-label">Amount</span><span style="font-weight:700;">NPR @_selected.Amount.ToString("N2")</span></div>
                <div class="tx-detail-row"><span class="tx-detail-label">Status</span><span class="badge-status @GetStatusClass(_selected.Status)">@_selected.Status</span></div>
                <div class="tx-detail-row"><span class="tx-detail-label">Date</span><span>@_selected.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</span></div>
                <div class="tx-detail-row"><span class="tx-detail-label">Description</span><span>@(_selected.Description ?? "—")</span></div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid? TransactionId { get; set; }

    private TransactionHistoryModel?   _history;
    private IEnumerable<TransactionModel>? _filtered;
    private TransactionModel?          _selected;
    private bool   _loading = true;
    private int    _page    = 1;
    private const int _pageSize = 15;
    private string _filterStatus    = string.Empty;
    private string _filterDirection = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Session.IsLoggedIn) { Nav.NavigateTo("/auth/login"); return; }
        if (firstRender) await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (TransactionId.HasValue && _history is not null)
            _selected = _history.Transactions.FirstOrDefault(t => t.TransactionId == TransactionId);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _history = await DashboardManager.GetTransactionsAsync(_page, _pageSize);
        ApplyFilter();
        _loading = false;
        StateHasChanged();
    }

    private void ApplyFilter()
    {
        var source = _history?.Transactions ?? Enumerable.Empty<TransactionModel>();
        if (!string.IsNullOrEmpty(_filterStatus))
            source = source.Where(t => t.Status == _filterStatus);
        if (!string.IsNullOrEmpty(_filterDirection))
            source = source.Where(t => t.Direction == _filterDirection);
        _filtered = source.ToList();
    }

    private async Task GoToPage(int pg) { _page = pg; await LoadAsync(); }
    private async Task PrevPage()       { if (_page > 1) await GoToPage(_page - 1); }
    private async Task NextPage()       { if (_history is not null && _page < _history.TotalPages) await GoToPage(_page + 1); }

    private static string GetStatusClass(string s) => s switch
    { "Completed"=>"badge-completed","Pending"=>"badge-pending","Failed"=>"badge-failed",_=>"" };
    private static string GetAvatarClass(string s) => s switch
    { "Completed"=>"avatar-green","Pending"=>"avatar-orange","Failed"=>"avatar-red",_=>"avatar-blue" };
}
