@page "/Error"
@using Microsoft.AspNetCore.Diagnostics
@layout MainLayout

<PageTitle>Error — DigiTransfer</PageTitle>

<div class="auth-centered-page">
    <div class="auth-center-card" style="text-align:center;">
        <h2 class="auth-center-title" style="color:#EF4444;">Something went wrong</h2>
        <p class="auth-center-sub">An unexpected error occurred. Please try again.</p>
        <a href="/" class="btn-primary" style="margin-top:1rem;display:inline-block;">Go Home</a>
    </div>
</div>
